{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dp/phase-transition.json",
  "title": "PhaseTransitionEvent",
  "allOf": [
    { "$ref": "../event-base.json" },
    {
      "type": "object",
      "required": ["type", "from_phase", "to_phase"],
      "properties": {
        "type": { "const": "phase_transition" },
        "from_phase": { "enum": ["none", "orient", "spec", "decide", "test", "implement", "review", "close"] },
        "to_phase": { "enum": ["orient", "spec", "decide", "test", "implement", "review", "close"] },
        "task_id": { "type": "string" },
        "spec_refs": { "type": "array", "items": { "type": "string", "pattern": "^SPEC-\\d+\\.\\d+$" } },
        "validation_passed": { "type": "boolean" }
      }
    }
  ]
}
